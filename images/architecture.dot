digraph home {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, pad=0.3, nodesep=0.30, ranksep=0.9, bgcolor="white", compound=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#f3f4f6", color="#9ca3af", margin="0.14,0.08"];
  edge  [fontname="Helvetica", fontsize=9, color="#6b7280", fontcolor="#374151"];

  subgraph cluster_clients {
    label="On the home network"; fontsize=11; style="rounded"; color="#d1d5db";
    iphone [label="iPhone\nHome app"];
    mac    [label="MacBook\nFinder (SMB)"];
    media  [label="Phones, TVs, PCs\nJellyfin apps"];
  }

  homepod [label="HomePod\nhome hub + Matter controller\n(remote access)", fillcolor="#fde68a", color="#d97706"];

  subgraph cluster_server {
    label="Ubuntu 26.04 home server (old i5 laptop, 32 GB RAM)"; fontsize=11;
    style="rounded,filled"; fillcolor="#eef2ff"; color="#818cf8";
    samba [label="Samba\nshares: disk1, disk2"];
    jelly [label="Jellyfin\n:8096"];
    hb    [label="Homebridge\nmain bridge + Eufy and Tuya child bridges\nUI :8581"];
    scr   [label="Scrypted\nONVIF + HomeKit plugins\n:10443"];
    disk1 [label="disk1 · 4 TB (exFAT)\nmovies, documents, photos,\nvideos, iPhone backups", shape=cylinder, fillcolor="#dcfce7", color="#16a34a"];
    disk2 [label="disk2 · 2 TB (exFAT)\nmanual copy of documents,\nphotos, videos", shape=cylinder, fillcolor="#dcfce7", color="#16a34a"];
  }

  subgraph cluster_devices {
    label="Devices"; fontsize=11; style="rounded"; color="#d1d5db";
    eufy   [label="eufy C220 deadbolts\n(front and back door)"];
    tuya   [label="Tuya room door locks\nvia Tuya Bluetooth gateway"];
    tapo   [label="6× Tapo C320WS cameras"];
    matter [label="Matter devices\nKasa KS225P3 dimmers,\nMeross garage opener"];
    sb     [label="SwitchBot Bot + Hub Mini\n(car start button)"];
  }

  mac   -> samba [label="SMB"];
  samba -> disk1;
  samba -> disk2;
  media -> jelly [label="stream"];
  jelly -> disk1 [label="Movies library"];

  iphone -> homepod [dir=both, label="HomeKit"];
  iphone -> hb  [label="HomeKit", style=dashed];
  iphone -> scr [label="HomeKit", style=dashed];
  homepod -> hb  [label="HomeKit"];
  homepod -> scr [label="HomeKit"];
  homepod -> matter [dir=both, label="Matter"];
  homepod -> sb [label="via Hub Mini"];

  hb  -> eufy [label="Eufy Security plugin"];
  hb  -> tuya [label="Tuya plugin"];
  scr -> tapo [label="ONVIF"];
}
